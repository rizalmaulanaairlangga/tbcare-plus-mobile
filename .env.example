# ─────────────────────────────────────────────────────────────────────
# TBCare+ Mobile — Environment Variables
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust for your environment.
#   cp .env.example .env
#
# NEVER commit the real .env file to source control.
# It is already listed in .gitignore.

# ── Backend API ──────────────────────────────────────────────────────

# Base URL of the TBCare+ backend API (no trailing slash).
# Production example: https://tbcare-plus-api-xxxxx.azurewebsites.net
API_BASE_URL=https://your-backend-api.azurewebsites.net

# Local development API URL (used when USE_LOCAL=true).
API_LOCAL_URL=http://localhost:5181

# Set to true to point the app at the local backend (API_LOCAL_URL).
# Android emulator users automatically get http://10.0.2.2:5181.
USE_LOCAL=false
